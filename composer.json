{
    "name": "automattic/woocommerce-simple-events",
    "description": "Test plugin exercising the WooCommerce Dual API plugin's engine end to end.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Automattic\\WooCommerceSimpleEvents\\Api\\": "src/Api/",
            "Automattic\\WooCommerceSimpleEvents\\Internal\\Api\\Autogenerated\\": "src/Internal/Api/Autogenerated/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
